<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NovelEngineAssemblies)/Inno.*.dll" />
    <Reference Include="$(NovelEngineAssemblies)/InnoEngine.Build.dll" />
  </ItemGroup>
  <Target Name="CheckEngine" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NovelEngineAssemblies)/Inno.Scripting.Compiler.dll')" Text="Supply NovelEngineAssemblies from the selected existing Build host." />
  </Target>
</Project>
