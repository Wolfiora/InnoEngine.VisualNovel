<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Inno.AssemblyDomain" Value="InnoInternal" />
    <AssemblyMetadata Include="Inno.AssemblyScope" Value="Editor" />
    <Compile Include="../../Assets/~Samples/ScriptExtension/DelayScoreCommand.cs.txt" Link="Samples/DelayScoreCommand.cs" />
    <Compile Include="../../Assets/~Samples/ScriptExtension/SetPageCountAction.cs.txt" Link="Samples/SetPageCountAction.cs" />
    <Compile Include="../../Assets/~Samples/ScriptExtension/PageCounterDataSource.cs.txt" Link="Samples/PageCounterDataSource.cs" />
    <Reference Include="$(NovelEngineAssemblies)/Inno.*.dll" />
    <Reference Include="$(NovelScriptOutput)/Inno.VisualNovel.*.dll" />
  </ItemGroup>
  <Target Name="CheckInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NovelScriptOutput)/Inno.VisualNovel.Narrative.dll')" Text="Compile the plugin through the formal scripts command first." />
  </Target>
</Project>
